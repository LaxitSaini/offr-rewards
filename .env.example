# ─────────────────────────────────────────────────────────────────────────────
# OFFR Rewards — environment configuration
# Copy to `.env.local` (development) or configure in your hosting provider.
# NEVER commit real secrets. The app refuses mock chain mode in production.
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the deployment (used in metadata + links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# Preferred: managed PostgreSQL (Neon / Supabase / Railway free tier).
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
#
# Fallback: SQLite file (great for a single small VM with a persistent disk).
SQLITE_PATH="./data/offr.db"

# ── Chain ───────────────────────────────────────────────────────────────────
# Any Base mainnet RPC. Public endpoints work for low volume; use Alchemy/QuickNode
# for production throughput.
BASE_RPC_URL="https://mainnet.base.org"
# live | mock   (mock is for local dev/tests only — refused in production)
CHAIN_MODE="live"
# Optional override if the token metadata read is unavailable:
# TOKEN_DECIMALS=18

# ── Telegram (optional, enables automatic membership verification) ──────────
# 1. Create a bot with @BotFather
# 2. Add the bot to the OFFR community chat as an admin (needed for getChatMember)
# 3. Set the chat id: numeric (-100…) or @username
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_CHAT_ID=""
# Only needed if you register a webhook instead of using the built-in polling:
TELEGRAM_WEBHOOK_SECRET=""

# ── X / Twitter (optional, enables API verification of submitted posts) ─────
# App-only bearer token from the X developer portal. Follow checks require
# user-context OAuth, which is NOT implemented — those claims are manual.
X_BEARER_TOKEN=""
X_ACCOUNT_HANDLE="OFFR35"

# ── Admin bootstrap ─────────────────────────────────────────────────────────
# On the first login attempt the app hashes ADMIN_PASSWORD with scrypt and stores
# only the hash. Use a long, unique password (12+ chars, letters + numbers).
ADMIN_EMAIL="team@offr.example"
ADMIN_PASSWORD=""
ADMIN_SESSION_HOURS="8"

# ── Rate limiting / proxying ────────────────────────────────────────────────
# Set to 0 if the app is NOT behind a trusted proxy (keeps X-Forwarded-For untrusted).
TRUST_PROXY="1"
# RATE_LIMIT_DISABLED="1"   # tests only

# ── Deployment-specific ─────────────────────────────────────────────────────
# Restrict accepted payout transactions to the official team wallet (recommended).
# TEAM_WALLET_ADDRESS="0x…"
# Only for preview environments that embed the app in an iframe. Leave unset in
# production so the app cannot be framed.
# ALLOW_IFRAME_EMBED="1"
