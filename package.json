{
  "name": "offr-rewards",
  "version": "1.0.0",
  "private": true,
  "description": "OFFR Rewards — Web3 community rewards campaign platform for $OFFR (Base Mainnet)",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:hash": "tsx scripts/provision-admin.ts",
    "seed": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "15.5.28",
    "postgres": "^3.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "viem": "^2.57.15",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
